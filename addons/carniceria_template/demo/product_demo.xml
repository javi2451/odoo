<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================= -->
    <!-- CATÁLOGO DEMO — CARNICERÍA                                     -->
    <!-- NOTA: uom_po_id fue eliminado en Odoo 19. Se usa solo uom_id. -->
    <!-- ============================================================= -->

    <!-- Producto primario: Media Canal de Res (para desposte) -->
    <record id="demo_media_res" model="product.template">
        <field name="name">Media Canal de Res</field>
        <field name="type">product</field>
        <field name="categ_id" ref="cat_carne_res"/>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="list_price">0.0</field>
        <field name="standard_price">9.50</field>
        <field name="es_corte_carne" eval="True"/>
        <field name="tipo_corte">primario</field>
        <field name="available_in_pos" eval="False"/>
    </record>

    <!-- Ribeye -->
    <record id="demo_corte_ribeye" model="product.template">
        <field name="name">Corte Ribeye (Ojo de Bife)</field>
        <field name="type">product</field>
        <field name="categ_id" ref="cat_carne_res"/>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="list_price">65.00</field>
        <field name="standard_price">38.00</field>
        <field name="es_corte_carne" eval="True"/>
        <field name="tipo_corte">secundario</field>
        <field name="dias_maduracion">21</field>
        <field name="available_in_pos" eval="True"/>
        <field name="to_weight" eval="True"/>
    </record>

